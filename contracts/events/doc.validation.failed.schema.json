{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://validador.local/contracts/events/doc.validation.failed.schema.json",
  "title": "doc.validation.failed",
  "description": "No se pudo procesar el documento (error técnico, no un documento inválido).",
  "type": "object",
  "required": [
    "specversion",
    "id",
    "source",
    "type",
    "time",
    "datacontenttype",
    "correlationid",
    "data"
  ],
  "properties": {
    "specversion": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "source": {
      "type": "string",
      "examples": [
        "/documents-service",
        "/doc-validator"
      ]
    },
    "type": {
      "const": "doc.validation.failed"
    },
    "time": {
      "type": "string",
      "format": "date-time"
    },
    "datacontenttype": {
      "const": "application/json"
    },
    "correlationid": {
      "type": "string"
    },
    "data": {
      "type": "object",
      "required": [
        "documentId",
        "attempt",
        "error"
      ],
      "properties": {
        "documentId": {
          "type": "string",
          "format": "uuid"
        },
        "attempt": {
          "type": "integer",
          "minimum": 1
        },
        "error": {
          "type": "object",
          "required": [
            "code",
            "message"
          ],
          "properties": {
            "code": {
              "type": "string",
              "examples": [
                "UNSUPPORTED_FILE",
                "BLOB_NOT_FOUND",
                "PROCESSING_ERROR"
              ]
            },
            "message": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
