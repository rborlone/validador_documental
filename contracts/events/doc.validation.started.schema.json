{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://validador.local/contracts/events/doc.validation.started.schema.json",
  "title": "doc.validation.started",
  "description": "El validador tomó el documento.",
  "type": "object",
  "required": [
    "specversion",
    "id",
    "source",
    "type",
    "time",
    "datacontenttype",
    "correlationid",
    "data"
  ],
  "properties": {
    "specversion": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "source": {
      "type": "string",
      "examples": [
        "/documents-service",
        "/doc-validator"
      ]
    },
    "type": {
      "const": "doc.validation.started"
    },
    "time": {
      "type": "string",
      "format": "date-time"
    },
    "datacontenttype": {
      "const": "application/json"
    },
    "correlationid": {
      "type": "string"
    },
    "data": {
      "type": "object",
      "required": [
        "documentId",
        "attempt"
      ],
      "properties": {
        "documentId": {
          "type": "string",
          "format": "uuid"
        },
        "attempt": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
